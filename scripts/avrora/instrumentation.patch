@@ -0,0 +1,146 @@
+package avrora.sim.radio;
+
+import avrora.sim.radio.Medium.Transmitter;
+
+public final class CustomTransmissionList {
+    public long[] firstBit;
+    public Transmitter[] transmitters;
+    public double[] Pt;
+    public double[] Freq;
+    public double[] power;
+    public long[] start;
+
+    // Object references for mutable field access (lastBit, end, counter, data)
+    private Medium.Transmission[] txRefs;
+
+    public int length;
+    private int capacity;
+
+    public CustomTransmissionList() {
+        this(16);
+    }
+
+    public CustomTransmissionList(int initialCapacity) {
+        capacity = initialCapacity;
+        length = 0;
+        firstBit = new long[capacity];
+        transmitters = new Transmitter[capacity];
+        Pt = new double[capacity];
+        Freq = new double[capacity];
+        power = new double[capacity];
+        start = new long[capacity];
+        txRefs = new Medium.Transmission[capacity];
+    }
+
+    public void add(Medium.Transmission tx) {
+        if (length == capacity) {
+            grow();
+        }
+        firstBit[length] = tx.firstBit;
+        transmitters[length] = tx.origin;
+        Pt[length] = tx.Pt;
+        Freq[length] = tx.f;
+        power[length] = tx.power;
+        start[length] = tx.start;
+        txRefs[length] = tx;
+        length++;
+    }
+
+    public void addFrom(CustomTransmissionList src, int srcIndex) {
+        if (length == capacity) {
+            grow();
+        }
+        firstBit[length] = src.firstBit[srcIndex];
+        transmitters[length] = src.transmitters[srcIndex];
+        Pt[length] = src.Pt[srcIndex];
+        Freq[length] = src.Freq[srcIndex];
+        power[length] = src.power[srcIndex];
+        start[length] = src.start[srcIndex];
+        txRefs[length] = src.txRefs[srcIndex];
+        length++;
+    }
+
+    public void clear() {
+        for (int i = 0; i < length; i++) {
+            transmitters[i] = null;
+            txRefs[i] = null;
+        }
+        length = 0;
+    }
+
+    public Transmitter getTransmitter(int index) {
+        return transmitters[index];
+    }
+
+    public double getPt(int index) {
+        return Pt[index];
+    }
+
+    public double getFrequency(int index) {
+        return Freq[index];
+    }
+
+    public long getFirstBit(int index) {
+        return firstBit[index];
+    }
+
+    public long getLastBit(int index) {
+        return txRefs[index].lastBit;
+    }
+
+    public Medium.Transmission getTransmissionRef(int index) {
+        return txRefs[index];
+    }
+
+    public byte getByteAtTime(int index, long bit) {
+        return txRefs[index].getByteAtTime(bit);
+    }
+
+    public int size() {
+        return length;
+    }
+
+    public void remove(int index) {
+        int numMoved = length - index - 1;
+        if (numMoved > 0) {
+            System.arraycopy(firstBit, index + 1, firstBit, index, numMoved);
+            System.arraycopy(transmitters, index + 1, transmitters, index, numMoved);
+            System.arraycopy(Pt, index + 1, Pt, index, numMoved);
+            System.arraycopy(Freq, index + 1, Freq, index, numMoved);
+            System.arraycopy(power, index + 1, power, index, numMoved);
+            System.arraycopy(start, index + 1, start, index, numMoved);
+            System.arraycopy(txRefs, index + 1, txRefs, index, numMoved);
+        }
+        length--;
+        transmitters[length] = null;
+        txRefs[length] = null;
+    }
+
+    private void grow() {
+        int newCapacity = capacity * 2;
+        long[] newFirstBit = new long[newCapacity];
+        Transmitter[] newTransmitters = new Transmitter[newCapacity];
+        double[] newPt = new double[newCapacity];
+        double[] newFreq = new double[newCapacity];
+        double[] newPower = new double[newCapacity];
+        long[] newStart = new long[newCapacity];
+        Medium.Transmission[] newTxRefs = new Medium.Transmission[newCapacity];
+
+        System.arraycopy(firstBit, 0, newFirstBit, 0, length);
+        System.arraycopy(transmitters, 0, newTransmitters, 0, length);
+        System.arraycopy(Pt, 0, newPt, 0, length);
+        System.arraycopy(Freq, 0, newFreq, 0, length);
+        System.arraycopy(power, 0, newPower, 0, length);
+        System.arraycopy(start, 0, newStart, 0, length);
+        System.arraycopy(txRefs, 0, newTxRefs, 0, length);
+
+        firstBit = newFirstBit;
+        transmitters = newTransmitters;
+        Pt = newPt;
+        Freq = newFreq;
+        power = newPower;
+        start = newStart;
+        txRefs = newTxRefs;
+        capacity = newCapacity;
+    }
+}
